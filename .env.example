# AccessFlow v7 optional Supabase configuration
#
# The app works without these values using browser localStorage.
# Add these values only after creating a Supabase project and running the SQL schema.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ACCESSFLOW_WORKSPACE_LABEL=prototype

# Optional: show Google staff sign-in button only after Google OAuth is configured in Supabase.
VITE_ENABLE_GOOGLE_AUTH=false
